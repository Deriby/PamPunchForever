; Pam: Punch Forever — projeto nativo Godot 4.4
config_version=5

[application]
config/name="Pam: Punch Forever"
run/main_scene="res://scenes/trail.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="A Trilha da Vingança — uma aventura original"

[display]
window/size/viewport_width=1152
window/size/viewport_height=720
window/size/window_width_override=1152
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.025,0.055,0.065,1)
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048

[physics]
common/physics_ticks_per_second=120
3d/default_gravity=24.0

[layer_names]
3d_physics/layer_1="World"
3d_physics/layer_2="Player body"
3d_physics/layer_3="Enemy body"
3d_physics/layer_4="Hurtboxes"
3d_physics/layer_5="Attacks"

[input]
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194319),Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194321),Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]}
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320),Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322),Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]}
jump={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32),Object(InputEventJoypadButton,"button_index":0)]}
light={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":74),Object(InputEventJoypadButton,"button_index":2)]}
heavy={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":75),Object(InputEventJoypadButton,"button_index":3)]}
spin={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":76),Object(InputEventJoypadButton,"button_index":1)]}
dodge={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325),Object(InputEventJoypadButton,"button_index":10)]}
confirm={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194309),Object(InputEventJoypadButton,"button_index":6)]}
pause={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305),Object(InputEventJoypadButton,"button_index":4)]}
debug={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194334)]}
restart={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":82)]}
